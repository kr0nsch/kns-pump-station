// Назначение: константы сборки ОВЕН ПЛК210: раскладка массивов, привязанных к каналам дерева устройств
//             (встроенные AI, каналы Modbus RTU ПЧ и TT403, канал Modbus TCP модуля МВ210-101). Константы
//             приложения — в GVL_Const; здесь только то, чего нет в сборке для CODESYS Control Win.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел 8.4; targets/plc210/README.md
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    // Встроенные AI ПЛК210-14: AI1…AI4 = A1.1…A1.4 перечня
    AI_FIRST : INT := 1;
    AI_LAST : INT := 4;
    // Канал чтения ПЧ: FC3, 4x 100…103 (docs/modbus_master_map.csv), 4 регистра
    MB_VFD_RD_STW : INT := 0;       // слово состояния
    MB_VFD_RD_FACT : INT := 1;      // фактическая частота, 0,01 Гц
    MB_VFD_RD_IT : INT := 2;        // ток двигателя, 0,1 А
    MB_VFD_RD_FCODE : INT := 3;     // код последней аварии
    MB_VFD_RD_LAST : INT := 3;      // последний индекс массива канала чтения
    // Канал записи ПЧ: FC16, 4x 0…1, 2 регистра, циклически: сторожевому таймеру связи ПЧ нужны запросы
    MB_VFD_WR_CTW : INT := 0;       // слово управления
    MB_VFD_WR_FREF : INT := 1;      // задание частоты, 0,01 Гц
    MB_VFD_WR_LAST : INT := 1;      // последний индекс массива канала записи
    // TT403: FC4, 3x 0…1, REAL, старшее слово первым (HL, перечень сигналов)
    MB_TT403_HI : INT := 0;
    MB_TT403_LO : INT := 1;
    // МВ210-101, вход 1 (A1.5): регистры 4000…4001, FLOAT32, младшее слово первым
    MB_MX_AI_LO : INT := 0;
    MB_MX_AI_HI : INT := 1;
    MB_PAIR_LAST : INT := 1;        // последний индекс массива из двух регистров
END_VAR
