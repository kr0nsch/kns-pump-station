// 04 §7.3, §9: ведущий прошлого цикла выбыл (авария ПЧ, блокировка станции) при выбранном ПИД — выход ПИД
// держится (слежение за собственным выходом), а не за заданием 0 выбывшего ПЧ; ПИД не выбран или ведущий доступен
// (пуск) — слежение за заданием ведущего, как раньше
METHOD PRIVATE HoldOutputWhenLeadDropsOut
VAR
    fbDut   : FB_LevelControlPid;           // ФБ под тестом
    fbTime  : PL.FB_FakeTime;               // подменное время, старт 1 ч
    stCfg   : ST_StationCfg;                // уставки по умолчанию (04 §18.2)
    afbPump : ARRAY[1..3] OF FB_FakeMotorVfd;   // подменные насосы
END_VAR
