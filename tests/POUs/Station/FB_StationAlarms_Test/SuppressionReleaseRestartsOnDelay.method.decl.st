// 04 §15, PMI-22, PMI-34: подавление по условию снято, а условие держится ещё цикл (станция видит выходы устройств
// циклом позже: после снятия «сухого хода» или восстановления питания насосы ещё «недоступны») — тревога не
// появляется: выдержка появления отсчитывается заново после снятия подавления (без мелькания High с сиреной)
METHOD PRIVATE SuppressionReleaseRestartsOnDelay
VAR
    fbDut  : FB_StationAlarms;          // ФБ под тестом
    fbTime : PL.FB_FakeTime;            // подменное время, старт 1 ч
    stCfg  : ST_StationCfg;             // тревоги по умолчанию (05_alarm_list.csv): NORES — 10 с
    itfAlm : PL.I_Alarm;                // тревога через интерфейс
    uiStep : UINT;                      // шаг времени
END_VAR
