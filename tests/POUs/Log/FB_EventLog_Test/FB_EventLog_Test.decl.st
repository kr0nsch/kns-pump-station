// Назначение: набор coUnit для FB_EventLog — кольцо на 200 записей: запись тревоги и события станции, номер
//             101000 + код, затирание самой старой записи и счётчик, порядок «новые первыми», страницы HMI,
//             курсор внешнего клиента и пропуск затёртых записей, время процесса lrMono_s, снимок для CSV.
//             Журнал (≈16 КБ) — переменная экземпляра метода (VAR_INST), а не стека: тест выполняется
//             за один вызов, повторные вызовы завершённого теста ассерты не проверяют.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, разделы 9.1, 14.1
FUNCTION_BLOCK FB_EventLog_Test EXTENDS coUnit.FB_TestSuite
VAR CONSTANT
    LR_EPS_S : LREAL := LREAL#1.0E-6;   // допуск времени процесса, с
    R_EPS : REAL := 1.0E-6;             // допуск значения записи
END_VAR
