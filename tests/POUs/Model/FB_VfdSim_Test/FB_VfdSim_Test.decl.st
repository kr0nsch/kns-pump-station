// Назначение: набор coUnit для FB_VfdSim — модель ПЧ по условной карте: рампа к заданию и торможение, реле
//             «Работа», авария с выбегом и сброс по фронту CTW.2, коды аварий, потеря связи (регистры замирают,
//             записи не доходят), сторожевой таймер 5 с → 50 Гц (04 §12, PMI-28, PMI-29), восстановление связи,
//             пропадание питания и загрузка, инъекции ОС, местный пуск (частота местного поста), ток в регистре,
//             «время назад».
//             Время — PL.FB_FakeTime, шаг 100 мс; разгон 0 → 50 Гц за 10 с (5 Гц/с).
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, разделы 11.3, 14.1
FUNCTION_BLOCK FB_VfdSim_Test EXTENDS coUnit.FB_TestSuite
VAR CONSTANT
    T_STEP : TIME := T#100MS;
    UI_1S : UINT := 10;               // шагов в 1 с
    R_EPS_HZ : REAL := 1.0E-3;
    UI_FREF_50HZ : UINT := 5000;      // 0,01 Гц
    UI_FREF_30HZ : UINT := 3000;
    UI_FREF_25HZ : UINT := 2500;
    R_LOCAL_HZ : REAL := 50.0;        // частота местного поста (SIM_VFD_LOCAL_FREQ_HZ)
END_VAR
