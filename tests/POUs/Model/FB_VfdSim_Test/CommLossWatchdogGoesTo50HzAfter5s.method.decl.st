// Сторожевой таймер ПЧ (04 §12): работающий на 30 Гц насос через 4,9 с без связи — ещё задание 30 Гц,
// в 5,0 с — 50 Гц, через 4 с разгона — 50 Гц. Стоящий насос без связи (последнее задание 0): пуск по
// проводу после срабатывания таймера — разгон до 50 Гц, а не работа на 0 Гц.
METHOD PRIVATE CommLossWatchdogGoesTo50HzAfter5s
VAR
    fbTime : PL.FB_FakeTime;    // подменное время
    fbDut : FB_VfdSim;          // проверяемая модель ПЧ
    uiI : UINT;
    fbStopped : FB_VfdSim;      // ПЧ стоящего насоса
END_VAR
