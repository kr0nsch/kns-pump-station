// записи FREF мастера в «Местном» не действуют; после возврата в «Дистанционное» — снова FREF.
METHOD PRIVATE LocalRunAtLocalPreset
VAR
    fbTime : PL.FB_FakeTime;    // подменное время
    fbDut : FB_VfdSim;          // проверяемая модель ПЧ
    uiI : UINT;
END_VAR
