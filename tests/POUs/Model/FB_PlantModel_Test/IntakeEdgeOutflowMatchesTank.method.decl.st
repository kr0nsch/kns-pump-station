// Отметка приёмка (0,30 м): решение «приёмок осушен» для гидравлики и для резервуара — одно и то же
// (по уровню LREAL резервуара). Уровень 0,29 м, насос 1 на 50 Гц; за шаг 0,2 с приток 2160,003 м³/ч
// поднимает его до 0,3000000052 м — в LREAL ниже отметки, а в REAL (0,30000001) уже на ней. Подача
// насоса (FT202, rOutflow_m3h), которую резервуар не откачивает, нарушала бы баланс массы. Затем
// установка уровня 1,0 м (подача есть) и 0,25 м (подачи нет) — шагами по 0,2 с (один подшаг).
METHOD PRIVATE IntakeEdgeOutflowMatchesTank
VAR
    fbTime : PL.FB_FakeTime;    // подменное время
    fbDut : FB_PlantModel;      // проверяемая модель
    stCfg : ST_SimCfg;          // параметры по умолчанию
    stCmd : ST_SimCmd;          // команды модели
    stFault : ST_FaultInjection;  // инъекции
    uiI : UINT;
END_VAR
