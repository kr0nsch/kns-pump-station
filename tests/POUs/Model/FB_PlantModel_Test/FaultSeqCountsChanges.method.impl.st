coUnit.TEST('PlantModel_FaultSeqCountsChanges');

fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axVfdFault[1] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
AssertEquals_UDINT(Expected := 1, Actual := fbDut.stSts.udiFaultSeq, Message := 'first change');
stFault.axNoFeedback[2] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axFeedbackStuck[3] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axAirLock[1] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axClog[2] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axOverheat[3] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axLeak[1] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axVfdCommLoss[2] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axLocal[3] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.axLocalRun[1] := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.aeAiFault[GVL_Const.SIM_AI_AT402] := E_SimAiFault.Freeze;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.arAiForced_mA[GVL_Const.SIM_AI_AT401] := 5.0;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.eLs102Stuck := E_SimFloatStuck.StuckNormal;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.eLs103Stuck := E_SimFloatStuck.StuckTripped;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xPowerLoss := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xUpsFault := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xTempCommLoss := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xFanFault := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xFanNoFeedback := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xValveChamberFlood := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.xFire := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.rH2S_mgm3 := 3.0;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
stFault.rCh4_pctLel := 7.0;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
AssertEquals_UDINT(Expected := UI_FAULT_FIELDS, Actual := fbDut.stSts.udiFaultSeq, Message := 'one per field');
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
AssertEquals_UDINT(Expected := UI_FAULT_FIELDS, Actual := fbDut.stSts.udiFaultSeq, Message := 'no change, no count');
stCmd.xClearFaults := TRUE;
fbDut(itfTime := fbTime, stCfg := stCfg, stCmd := stCmd, stFault := stFault);
AssertEquals_UDINT(Expected := UI_FAULT_FIELDS + 1, Actual := fbDut.stSts.udiFaultSeq, Message := 'clear counts once');

coUnit.TEST_FINISHED();
