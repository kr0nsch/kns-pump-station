// Насос, с которого снимается запрос, когда нужно меньше насосов (04 §5.2): RunHours — с большей
// наработкой (затем больше пусков, затем больший номер), Cyclic и Fixed — подпорный, выданный
// последним; ведущий — только если подпорных нет. 0 — нет запрошенных
METHOD PRIVATE PickToRemove : UINT
VAR_INPUT
    eRot : E_RotationMode;              // режим чередования
END_VAR
VAR
    uiIdx : UINT;                       // номер насоса
END_VAR
